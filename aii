  <p id="status" role="status" aria-live="polite">채팅에 연결하는 중입니다...</p>
  <div id="webchat" style="height: 600px"></div>
  <script src="https://cdn.botframework.com/botframework-webchat/4.18.0/webchat.js"></script>
  <script>
    const BROKER_URL = "https://dl-broker-juwon-4jt3z.azurewebsites.net/api/directlineToken";
    const SEALED = "jTjoEw7kjQrr4kTIn-lte_S9xyOJ1a_AOFaIj5I6FVIntFHP-ZXJ86H66ZvIvidXbvtappOkk40PFCTQsN2CSpLja_HiNkke2mLECALDGFdDIdM-KGu3jK4KxsTMqdMYzEP0_3TpK4NuO3C-MuJJ2Fj1n_bpqLsDTVn_PFHaFZT7007eMfkA8SQUyOQYfuyEEcyex-RGTQ2zwt7JSZScWTGlDhjCQzEshwCAt9NreleRR85rxKhQc-4oFijgFAdHo8fzwu_cEJkLAgTxtL3TE4ShX_KLBeVKIjQLrVqu1v2GlXudjt-nY-xNP_0jplteo7gcMlVu419Zz3n7Zu1R0qNPj4-US2v_FPEKA552QxzvetJABLrGHmt2ZPja-NRK-yJHKhn1VjyN77E9qNSpMdbi0BNoG5WQihhalI8V8sHUtHd7WLXCqu1mWSeNGI_Fa_OWxHZvuRUSkBQntI9s2BRmiBS66HazAjzGw2ytkKfyC5yXTD0yDvsE86TKT8NBgeATXB9z5lVp3eh9RvD9tnaZgR1VQdZnbxo-6Xv4Hhl6Sxmhjm9hV645H94sc7IMVN4eVJe1pWnrgIda5BqvIlf_m_AIIjuU-etkxG0iLeuuENnn33NAG4bQoIsRDOA1RohCD7sYMOVPEVMm_V994Is2YnhunA";
    const status = document.getElementById("status");

    function showError(message) {
      status.hidden = false;
      status.textContent = message;
    }

    async function connect() {
      if (!window.WebChat ||
          typeof WebChat.createDirectLine !== "function" ||
          typeof WebChat.renderWebChat !== "function") {
        showError("채팅 구성 요소를 불러오지 못했습니다. 네트워크를 확인한 뒤 새로고침해 주세요.");
        return;
      }

      let response;
      try {
        // Keep this a simple CORS request; the broker may not support preflight.
        response = await fetch(BROKER_URL, {
          method: "POST",
          body: JSON.stringify({ sealed: SEALED })
        });
      } catch {
        showError("서버에 연결하지 못했습니다. 네트워크와 배포 주소를 확인해 주세요.");
        return;
      }
      if (!response.ok) {
        showError("서버가 연결 요청을 처리하지 못했습니다 (HTTP " + response.status + ").");
        return;
      }

      let data;
      try {
        data = await response.json();
      } catch {
        showError("서버 응답을 읽을 수 없습니다. 잠시 후 다시 시도해 주세요.");
        return;
      }
      if (!data || typeof data.token !== "string" || !data.token.trim()) {
        showError("서버에서 연결 토큰을 받지 못했습니다. 암호와 배포 주소를 확인해 주세요.");
        return;
      }

      try {
        const directLine = WebChat.createDirectLine({ token: data.token });
        status.hidden = true;
        directLine.postActivity({
          type: "event", name: "startConversation", from: { id: "user" }
        }).subscribe({
          error: () => showError("첫 인사를 요청하지 못했습니다. 채팅창에 메시지를 입력해 주세요.")
        });
        WebChat.renderWebChat({ directLine, locale: "ko-KR" }, document.getElementById("webchat"));
      } catch {
        showError("채팅을 시작하지 못했습니다. 새로고침 후 다시 시도해 주세요.");
      }
    }

    connect();
  </script>
</body>
</html>
